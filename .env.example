# Database — PostgreSQL (required)
# Local: docker compose up -d  →  URLs below
# Production (Neon / Supabase / Vercel Postgres): use pooled URL + direct URL
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/voiceops?schema=public"
# Same as DATABASE_URL for local Docker; for Neon use the non-pooler / direct connection
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/voiceops?schema=public"

# Public URL of this app — used for Bolna webhook callbacks
# Local dev: use ngrok, e.g. https://abc123.ngrok-free.app
# Production: your Vercel deployment URL
PUBLIC_URL="http://localhost:3000"

# Bolna Voice AI — https://platform.bolna.ai
BOLNA_API_KEY=""
# Per-segment agents (recommended). BOLNA_AGENT_ID is fallback if a segment ID is omitted.
BOLNA_AGENT_ID_LEADS=""
BOLNA_AGENT_ID_COD=""
BOLNA_AGENT_ID_NDR=""
# BOLNA_AGENT_ID=""

# Optional: force all outbound calls to one verified number (useful for Bolna trial accounts)
# BOLNA_VERIFIED_RECIPIENT_PHONE="+917004858548"

# Optional: caller ID in E.164 format if your Bolna account requires it
# BOLNA_FROM_PHONE="+91XXXXXXXXXX"

# Auto-dialer cron (production / Vercel). Bearer token for GET/POST /api/cron/dialer
# CRON_SECRET="your-random-secret"

# Event ingest (POST /api/events/collect and /api/events/shopify). Omit to allow unauthenticated ingest in dev.
# EVENTS_API_KEY="your-events-secret"

# Prepaid simulated NDR after LEADS conversion (payment_type PREPAID)
# PREPAID_NDR_FAILURE_RATE="0.25"
# PREPAID_NDR_MIN_FORCED_FAILURES="5"

# Optional for local lead discovery worker:
# INTERVAL="10"
# LIMIT="20"

# Vitest uses voiceops_test (created by docker/postgres/init.sql)
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/voiceops_test?schema=public"
