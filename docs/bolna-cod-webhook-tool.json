{
  "name": "post_api_bolna_webhook_cod",
  "description": "POST terminal call execution to the ops app COD webhook. Call.segment must already be COD; routing uses execution_id only.",
  "pre_call_message": "One moment while I submit your call result.",
  "parameters": {
    "type": "object",
    "required": ["id", "execution_id", "status", "extracted_data"],
    "properties": {
      "id": {
        "type": "string",
        "description": "Bolna execution id (same as execution_id)"
      },
      "execution_id": {
        "type": "string",
        "description": "Must match Call.bolnaExecutionId from the outbound COD call"
      },
      "status": {
        "type": "string",
        "description": "Terminal: completed | failed | no-answer | busy. Non-terminal statuses update Call only.",
        "enum": ["completed", "failed", "no-answer", "busy", "in-progress", "ringing", "initiated"]
      },
      "conversation_duration": {
        "type": "integer",
        "description": "Call length in seconds (optional)"
      },
      "total_cost": {
        "type": "number",
        "description": "Bolna-reported execution cost (optional; stored as costInr)"
      },
      "transcript": {
        "type": "string",
        "description": "Full conversation transcript (optional)"
      },
      "recording_url": {
        "type": "string",
        "description": "Recording URL (optional)"
      },
      "extracted_data": {
        "type": "object",
        "required": ["outcome", "reason"],
        "properties": {
          "outcome": {
            "type": "string",
            "description": "COD structured outcome — exactly one per call",
            "enum": [
              "COD_CONFIRMED",
              "COD_REJECTED",
              "WRONG_ADDRESS",
              "CALLBACK",
              "NO_ANSWER"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Short factual summary; used for Order.failureReason when not confirmed"
          },
          "language_used": {
            "type": "string",
            "description": "Optional: en | hi | hi-en"
          },
          "sentiment": {
            "type": "string",
            "description": "Optional: positive | neutral | negative"
          },
          "address_update": {
            "type": "string",
            "description": "Optional: corrected address if customer provided during call"
          },
          "address_short": {
            "type": "string",
            "description": "Optional: short form of updated address"
          },
          "callback_day": {
            "type": "string",
            "description": "Optional: customer-requested callback day (not persisted on Order today)"
          },
          "callback_time": {
            "type": "string",
            "description": "Optional: customer-requested callback time (not persisted on Order today)"
          }
        }
      }
    }
  },
  "key": "custom_task",
  "value": {
    "method": "POST",
    "url": "https://YOUR_PUBLIC_URL/api/bolna-webhook",
    "api_token": null,
    "headers": {
      "Content-Type": "application/json"
    },
    "param": {
      "id": "%(id)s",
      "execution_id": "%(execution_id)s",
      "status": "%(status)s",
      "conversation_duration": "%(conversation_duration)i",
      "total_cost": "%(total_cost)s",
      "transcript": "%(transcript)s",
      "recording_url": "%(recording_url)s",
      "extracted_data": {
        "outcome": "%(outcome)s",
        "reason": "%(reason)s",
        "language_used": "%(language_used)s",
        "sentiment": "%(sentiment)s",
        "address_update": "%(address_update)s",
        "address_short": "%(address_short)s",
        "callback_day": "%(callback_day)s",
        "callback_time": "%(callback_time)s"
      }
    }
  }
}
