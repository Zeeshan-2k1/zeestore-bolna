{
  "name": "post_api_bolna_webhook_ndr",
  "description": "POST terminal call execution to the ops app NDR webhook. Call.segment must already be NDR; routing uses execution_id only.",
  "pre_call_message": "One moment while I submit your call result.",
  "parameters": {
    "type": "object",
    "required": ["id", "execution_id", "status", "extracted_data"],
    "properties": {
      "id": {
        "type": "string",
        "description": "Bolna execution id (same as execution_id)"
      },
      "execution_id": {
        "type": "string",
        "description": "Must match Call.bolnaExecutionId from the outbound NDR call"
      },
      "status": {
        "type": "string",
        "description": "Terminal: completed | failed | no-answer | busy. Non-terminal statuses update Call only.",
        "enum": ["completed", "failed", "no-answer", "busy", "in-progress", "ringing", "initiated"]
      },
      "conversation_duration": {
        "type": "integer",
        "description": "Call length in seconds (optional)"
      },
      "total_cost": {
        "type": "number",
        "description": "Bolna-reported execution cost (optional; stored as costInr)"
      },
      "transcript": {
        "type": "string",
        "description": "Full conversation transcript (optional)"
      },
      "recording_url": {
        "type": "string",
        "description": "Recording URL (optional)"
      },
      "extracted_data": {
        "type": "object",
        "required": ["outcome", "reason"],
        "properties": {
          "outcome": {
            "type": "string",
            "description": "NDR structured outcome — exactly one per call",
            "enum": [
              "REATTEMPT_CONFIRMED",
              "RTO_CONFIRMED",
              "RESCHEDULE",
              "ADDRESS_UPDATE",
              "SECONDARY_CONTACT",
              "NEED_HUMAN",
              "NO_ANSWER"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Short factual summary of the resolution"
          },
          "selected_slot_id": {
            "type": "string",
            "description": "Reattempt slot id from reattempt_slots_json: S1 | S2 | S3 (REATTEMPT_CONFIRMED)"
          },
          "reschedule_date": {
            "type": "string",
            "description": "ISO date for custom reschedule (RESCHEDULE), e.g. 2026-06-05"
          },
          "address_update": {
            "type": "string",
            "description": "Full corrected address (ADDRESS_UPDATE)"
          },
          "address_mode": {
            "type": "string",
            "description": "primary | secondary — whether to replace primary or store secondary address",
            "enum": ["primary", "secondary", "replace"]
          },
          "address_short": {
            "type": "string",
            "description": "Short address label after update"
          },
          "secondary_phone": {
            "type": "string",
            "description": "Alternate contact phone (SECONDARY_CONTACT)"
          },
          "language_used": {
            "type": "string",
            "description": "Optional: en | hi | hi-en"
          },
          "sentiment": {
            "type": "string",
            "description": "Optional: positive | neutral | negative"
          }
        }
      }
    }
  },
  "key": "custom_task",
  "value": {
    "method": "POST",
    "url": "https://YOUR_PUBLIC_URL/api/bolna-webhook",
    "api_token": null,
    "headers": {
      "Content-Type": "application/json"
    },
    "param": {
      "id": "%(id)s",
      "execution_id": "%(execution_id)s",
      "status": "%(status)s",
      "conversation_duration": "%(conversation_duration)i",
      "total_cost": "%(total_cost)s",
      "transcript": "%(transcript)s",
      "recording_url": "%(recording_url)s",
      "extracted_data": {
        "outcome": "%(outcome)s",
        "reason": "%(reason)s",
        "selected_slot_id": "%(selected_slot_id)s",
        "reschedule_date": "%(reschedule_date)s",
        "address_update": "%(address_update)s",
        "address_mode": "%(address_mode)s",
        "address_short": "%(address_short)s",
        "secondary_phone": "%(secondary_phone)s",
        "language_used": "%(language_used)s",
        "sentiment": "%(sentiment)s"
      }
    }
  }
}
